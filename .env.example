# Default to the OpenFreeMap liberty style.
VITE_MVT_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MVT_STYLE_SOURCE=openmaptiles

# Direct tile template override example:
# VITE_MVT_URL_TEMPLATE=https://example.com/tiles/{z}/{x}/{y}.pbf
# VITE_MVT_SOURCE_ID=demo-mvt
# VITE_MVT_SUBDOMAINS=abc
# VITE_MVT_MIN_LEVEL=0
# VITE_MVT_MAX_LEVEL=14
# VITE_MVT_TILE_WIDTH=256
# VITE_MVT_TILE_HEIGHT=256
# VITE_MVT_MAX_CONCURRENT=4
# VITE_MVT_CACHE_SIZE=64
